# 复制为 config.env 后按需修改；config.env 不会进入 git。所有变量都可以被同名环境变量覆盖。
# Copy to config.env and edit it; config.env is not tracked by git. Every variable can be overridden by an environment variable of the same name.

# 你本机合法拥有的 Mac 版游戏（.app 包）；下面是 Steam 版的默认位置
# The Mac version of the game you legally own (the .app bundle); the default below is where Steam installs it
GAME_APP="$HOME/Library/Application Support/Steam/steamapps/common/Disco Elysium/disco.app"

# 必填：Apple 开发者团队 ID（10 位，开发证书的 OU 字段），用于 Xcode 自动签名
# Required: your Apple developer Team ID (10 characters, the OU field of your development certificate), used for automatic signing
TEAM_ID=""

# 必填：你自己的 Bundle ID，在你的团队里唯一；不要使用原游戏的 com.zaumstudio.*
# Required: your own bundle ID, unique within your team; do not use the original game's com.zaumstudio.*
BUNDLE_ID=""

# devicectl 设备标识（UDID 或名称）；留空则自动选第一台已配对的实体 iPad
# devicectl device identifier (UDID or name); leave empty to pick the first paired physical iPad
DEVICE=""

# 游戏所用的 Unity 版本，必须与 Mac 版 Info.plist 中的版本完全一致；下面的 SHA-256 对应这个版本的 iOS Support 包
# The game's Unity version; it must match the Mac build's Info.plist exactly. The SHA-256 below is for this version's iOS Support package
UNITY_VERSION="2020.3.12f1"
UNITY_CHANGESET="b3b2c6512326"
UNITY_IOS_PKG_SHA256="33c739fcc638836333cfd83210b50103e206f6ff806a53f497bb33c1fecbfe55"

# iOS 最低版本（硬件 BC 纹理需要 iPadOS 16.4 以上）
# Minimum iOS version (hardware BC textures need iPadOS 16.4 or later)
IOS_DEPLOYMENT_TARGET="17.0"
